<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kcal_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".KcalActivity">

    <ImageView
        android:id="@+id/btn_back_arrow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_back_arrow"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_main" />

    <TextView
        android:id="@+id/tv_kcal_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/kcal_calc"
        android:textColor="@color/text_main"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back_arrow" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_kcal_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_kcal_title"
        app:layout_constraintWidth_percent="0.9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <EditText
                android:id="@+id/et_kcal_weight"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="#F1F3F5"
                android:hint="@string/weight_hint"
                android:inputType="numberDecimal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:autofillHints="none" />

            <EditText
                android:id="@+id/et_kcal_height"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="#F1F3F5"
                android:hint="@string/height_hint"
                android:inputType="numberDecimal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:autofillHints="none" />

            <EditText
                android:id="@+id/et_kcal_age"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="#F1F3F5"
                android:hint="@string/age_hint"
                android:inputType="number"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_hint"
                android:autofillHints="none" />

            <Button
                android:id="@+id/btn_calculate_kcal"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/purple_end"
                android:text="@string/calculate"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_kcal_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/text_main"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/card_kcal_input"
        app:layout_constraintStart_toStartOf="@id/card_kcal_input"
        app:layout_constraintTop_toBottomOf="@id/card_kcal_input" />

</androidx.constraintlayout.widget.ConstraintLayout>